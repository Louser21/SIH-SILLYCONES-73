{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sih-sillycones-73/contracts/sensor-reading.schema.json",
  "title": "SensorReading",
  "type": "object",
  "required": ["station_id", "timestamp", "temperature", "humidity"],
  "properties": {
    "station_id": {
      "type": "string",
      "minLength": 1,
      "example": "S01"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "example": "2026-09-05T12:30:00Z"
    },
    "temperature": {
      "type": "number",
      "example": 34.2
    },
    "humidity": {
      "type": "number",
      "example": 71.0
    }
  },
  "additionalProperties": false
}
